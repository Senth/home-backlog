# Firebase Configuration
# Get these from Firebase Console > Project Settings > Web App
EXPO_PUBLIC_FIREBASE_API_KEY=
# Set this to the origin the app is served from, NOT
# home-backlog.firebaseapp.com. Firebase Hosting reserves /__/auth/ on every
# domain it serves, so a same-origin handler is available — and a same-origin
# handler is what keeps signInWithRedirect working in Safari. The host must be
# on the Firebase authorized-domain list and https://<host>/__/auth/handler
# must be an authorized redirect URI on the web OAuth client. Left blank, the
# app falls back to its own origin.
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=hb.senth.org
EXPO_PUBLIC_FIREBASE_PROJECT_ID=home-backlog
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=home-backlog.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
