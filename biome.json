{
	"$schema": "https://schemas.biomejs.dev/biome/2.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!.claude/settings.local.json", "!.emulator-seed"]
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noReactNativeRawText": {
					"level": "error",
					"options": {
						"skip": ["Button"]
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts", "**/*.test.tsx"],
			"linter": {
				"rules": {
					"nursery": {
						"noFloatingPromises": "error"
					}
				}
			}
		}
	]
}
