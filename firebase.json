{
	"hosting": {
		"public": "dist",
		"ignore": ["firebase.json", "**/.*"],
		"cleanUrls": true,
		"rewrites": [
			{
				"source": "/api/**",
				"function": {
					"functionId": "api",
					"region": "europe-west1"
				}
			},
			{
				"source": "**",
				"destination": "/index.html"
			}
		],
		"headers": [
			{
				"source": "/sw.js",
				"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
			},
			{
				"source": "/sw-routing.js",
				"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
			},
			{
				"source": "/manifest.webmanifest",
				"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
			}
		]
	},
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	},
	"functions": [
		{
			"source": "functions",
			"codebase": "default",
			"ignore": [
				"node_modules",
				".git",
				"src",
				"jest.config.js",
				"tsconfig.json",
				"firebase-debug.log",
				"firebase-debug.*.log"
			],
			"predeploy": ["yarn --cwd \"$PROJECT_DIR/functions\" build"]
		}
	],
	"storage": [
		{
			"target": "default",
			"bucket": "home-backlog.firebasestorage.app",
			"rules": "storage.rules"
		}
	],
	"emulators": {
		"ui": {
			"enabled": true,
			"port": 8060
		},
		"auth": {
			"port": 8061
		},
		"firestore": {
			"port": 8062
		},
		"storage": {
			"port": 8063
		},
		"functions": {
			"port": 8064
		},
		"singleProjectMode": true
	}
}
