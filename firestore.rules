rules_version = '2';

// Data is scoped to a home. Membership lives in a `members` map on the home doc
// (uid -> 'owner' | 'member'), which every subcollection rule reads through a
// get(). That costs one document read per rule evaluation, which is the price of
// keeping membership in one place.
//
// Reads must also be *query*-safe: Firestore rejects an entire query if any
// matching document could be denied, so a board load runs two queries —
// `visibility == 'shared'` and `participantIds array-contains me` — and merges
// them client-side. Never widen a node read rule beyond what those two queries
// can prove.
service cloud.firestore {
  match /databases/{database}/documents {
    allow read, write: if false;

    function signedIn() {
      return request.auth != null;
    }

    // Every use of emailHash() must be guarded by this: `.lower()` on a null
    // email is an error, and an errored expression denies the whole request
    // rather than the one branch that asked.
    function hasEmail() {
      return signedIn() && request.auth.token.email != null;
    }

    // Invites are keyed by the SHA-256 of the lowercased invitee email so the
    // address itself never has to be readable by other members.
    //
    // `lower()` is **ASCII-only**, and `lowerAscii()` in `models/home.ts` mirrors
    // it deliberately. Do not widen either side alone: this hash is compared
    // against the `memberEmailHashes` entry a client wrote, so a client that
    // folded further would be refused its own entry — and that entry is required
    // to create a home and to accept an invitation.
    function emailHash() {
      return hashing.sha256(request.auth.token.email.lower()).toHexString().lower();
    }

    // Nothing may leave a home without an owner. The remaining members could
    // edit nodes forever but never invite, never remove and never delete, and
    // no action inside the app could recover it — so the invariant lives here,
    // where the REST API (#7) inherits it, not in a component.
    function hasAnOwner(members) {
      return members.values().hasAny(['owner']);
    }

    function validHome(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && hasAnOwner(data.members);
    }

    function homeData(homeId) {
      return get(/databases/$(database)/documents/homes/$(homeId)).data;
    }

    function roleIn(members) {
      return members.get(request.auth.uid, null);
    }

    function isMember(homeId) {
      return signedIn() && roleIn(homeData(homeId).members) != null;
    }

    function isOwner(homeId) {
      return signedIn() && roleIn(homeData(homeId).members) == 'owner';
    }

    match /homes/{homeId} {
      // resource.data is already loaded here, so membership needs no extra get().
      function memberOfThis() {
        return signedIn() && roleIn(resource.data.members) != null;
      }

      function ownerOfThis() {
        return signedIn() && roleIn(resource.data.members) == 'owner';
      }

      // Names, photos and email hashes sit in sibling maps rather than inside
      // `members`, whose uid -> role shape six expressions here depend on. The
      // maps are absent on a home written before they existed, so every read of
      // them goes through get() with an empty default.
      function profiles(data) {
        return data.get('memberProfiles', {});
      }

      function hashes(data) {
        return data.get('memberEmailHashes', {});
      }

      function touchesOnlyMe(next, current) {
        return next.diff(current).affectedKeys().hasOnly([request.auth.uid]);
      }

      // You may write an email hash under your own uid only if it is the hash of
      // your own address. Without this, anyone could plant somebody else's hash
      // on themselves and be mistaken for them by the "already a member?" check
      // the invite form runs.
      function ownHashIsOwn(data) {
        return hashes(data).get(request.auth.uid, null) == null
          || (hasEmail() && hashes(data).get(request.auth.uid, null) == emailHash());
      }

      // A member removes *only* themselves — the one membership change that is
      // not an owner's to make, and without it nobody but an owner could ever
      // leave. Still subject to validHome(), which is what traps the last owner
      // until they make somebody else an admin.
      function leavesHome() {
        return memberOfThis()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'memberProfiles', 'memberEmailHashes'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.members)
          && touchesOnlyMe(profiles(request.resource.data), profiles(resource.data))
          && touchesOnlyMe(hashes(request.resource.data), hashes(resource.data));
      }

      // An invited user adds *only* themselves, with *only* the role their
      // invite grants, and touches nobody else's profile or hash.
      function acceptsInvite() {
        let invite = /databases/$(database)/documents/homes/$(homeId)/invites/$(emailHash());
        return hasEmail()
          && request.auth.token.email_verified == true
          && exists(invite)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'memberProfiles', 'memberEmailHashes'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && touchesOnlyMe(profiles(request.resource.data), profiles(resource.data))
          && touchesOnlyMe(hashes(request.resource.data), hashes(resource.data))
          && hashes(request.resource.data).get(request.auth.uid, null) == emailHash()
          && request.resource.data.members.get(request.auth.uid, null) == get(invite).data.role;
      }

      allow get, list: if memberOfThis();
      allow create: if signedIn()
        && request.resource.data.members.get(request.auth.uid, null) == 'owner'
        && validHome(request.resource.data)
        && hasEmail()
        && hashes(request.resource.data).get(request.auth.uid, null) == emailHash();
      // Members may edit the home itself and maintain their own profile entry;
      // only an owner may rewrite membership — an owner has to be able to touch
      // anyone's entries, because removing a member removes theirs too — except
      // for an invitee accepting their own invite.
      allow update: if validHome(request.resource.data)
        && ownHashIsOwn(request.resource.data)
        && (
          ownerOfThis()
          || (memberOfThis()
              && request.resource.data.members == resource.data.members
              && touchesOnlyMe(profiles(request.resource.data), profiles(resource.data))
              && touchesOnlyMe(hashes(request.resource.data), hashes(resource.data)))
          || leavesHome()
          || acceptsInvite()
        );
      // Deleting a home leaves its nodes, locations and recurring rules stored
      // but permanently unreachable — every one of their rules resolves
      // membership through a get() on this document. Until a Cloud Function can
      // cascade (#1, #39), delete is offered only to a sole member, where the
      // client-side cascade is bounded and cannot revoke anyone else's access.
      allow delete: if ownerOfThis() && resource.data.members.keys().size() == 1;

      match /invites/{emailHashId} {
        allow read: if isOwner(homeId)
          || (hasEmail() && emailHashId == emailHash());
        // The hash is stored as a field as well as the key so it can be found by
        // a collection-group query; requiring the two to agree is what stops an
        // owner poisoning that query with somebody else's hash.
        allow create, update: if isOwner(homeId)
          && request.resource.data.role in ['owner', 'member']
          && request.resource.data.emailHash == emailHashId;
        // An invitee may consume or decline their own invite.
        allow delete: if isOwner(homeId)
          || (hasEmail() && emailHashId == emailHash());
      }

      // The one document type every board, task and subtask is made of. These
      // invariants live here rather than in a component so the REST API (#7)
      // and any agent driving it inherit every one of them.
      match /nodes/{nodeId} {
        function visibleToMe(node) {
          return node.visibility == 'shared'
            || request.auth.uid in node.participantIds;
        }

        // Every field is written on create, so reading an absent one here is an
        // error — which denies the write, which is the answer wanted. A field
        // that is absent can never be queried either: Firestore does not index
        // one, so `archived == false` would silently skip every document
        // written before `archived` existed.
        //
        // `request.resource.data` is the full post-update document, so this
        // costs the same on an update as on a create and no partial patch can
        // slip past it.
        // The status vocabulary, in one place: `status` is one of these and every
        // entry of `columns` is one of these, and the two must never drift.
        //
        // There is deliberately no `blocked`. A card is in exactly one status, so
        // parking one in Blocked destroys the stage it was in and nothing says
        // where it goes when the blocker clears. Being blocked is a *condition*,
        // carried by `blockedBy[]` (#66), not a stage.
        function allStatuses() {
          return ['backlog', 'next_up', 'research', 'planning', 'execution',
                  'review', 'done'];
        }

        function validNode(data) {
          return data.title is string
            && data.title.size() >= 1
            && data.title.size() <= 200
            && data.status in allStatuses()
            // The column set of the board this node's children form. Required on
            // create like every other field, and *not* immutable: #63 is the
            // feature that edits it, and locking it here would make #63 a rules
            // change before it could be a screen.
            && data.columns is list
            && data.columns.size() >= 1
            && data.columns.size() <= allStatuses().size()
            && data.columns.hasOnly(allStatuses())
            // Denormalized counts of this node's direct children, and of the
            // ones that are done. `is int` and nothing more, deliberately:
            // they are a display convenience, not an invariant.
            //
            // `doneCount >= 0` looks correct and is a trap. One device offline
            // marks a step done while another deletes that step, and the
            // transformed value can dip below zero — which would reject the
            // whole batch and fail a *delete*, an operation whose atomicity
            // this area is built around. `toNode` clamps on read instead, where
            // the worst a wrong value can do is draw a chevron.
            && data.childCount is int
            && data.doneCount is int
            && data.rank is string
            && data.rank.size() > 0
            && (data.parentId == null || data.parentId is string)
            && data.ancestorIds is list
            && (data.locationId == null || data.locationId is string)
            && data.locationAncestorIds is list
            && data.participantIds is list
            && data.blockedBy is list
            && data.visibility in ['shared', 'private']
            // A calendar day, not an instant: "by Sep 30" is the same day in
            // every timezone, and lexicographic order is chronological.
            && (data.dueDate == null
                || (data.dueDate is string
                    && data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
            && (data.priority == null
                || data.priority in ['low', 'normal', 'high', 'urgent'])
            && (data.effort == null
                || data.effort in ['quick', 'hours', 'evening', 'weekend',
                                   'multi_week'])
            && data.notes is string
            && data.notes.size() <= 10000
            && data.checklist is list
            && data.checklist.size() <= 200
            && data.photos is list
            && data.photos.size() <= 50
            && data.archived is bool
            && (data.completedAt == null || data.completedAt is timestamp)
            // A completion date is not reconstructible after the fact, and
            // deriving it from `updatedAt` is wrong the moment anyone edits a
            // finished node. So the two agree, in both directions.
            && (data.status == 'done') == (data.completedAt != null)
            // Required so that immutable() below has something to compare. A
            // document created without them could never be updated again.
            && data.createdAt is timestamp
            && data.createdBy is string
            && data.updatedAt is timestamp;
        }

        // Validated structurally, with no get(): a rule's get() reads
        // *committed* state and cannot see the rest of a writeBatch, so a check
        // against the parent's new value would refuse every reparent — which
        // rewrites a node and its descendants at once. A descendant's parentId
        // does not change during a reparent, so its rewritten ancestorIds
        // passes here inside the batch.
        //
        // What this gives up is full-path verification: a wrong *grandparent*
        // id passes. That is the recoverable class of error — parentId is the
        // source of truth and ancestorIds is derived from it, so a corrupt path
        // is always recomputable.
        function structure(data) {
          return (data.parentId == null
                  ? data.ancestorIds.size() == 0
                  : (data.ancestorIds.size() > 0
                     && data.ancestorIds[data.ancestorIds.size() - 1] == data.parentId))
            && !(nodeId in data.ancestorIds);
        }

        // The invariant that makes privacy *queryable*: a node's visibility
        // equals its parent's, and a private node carries all of its parent's
        // participants.
        //
        // Firestore has no field-level read rules, and a query may contain only
        // one array-contains clause — so `ancestorIds array-contains X &&
        // participantIds array-contains me` is not expressible. Without this,
        // no client query can see another member's private descendant, so a
        // reparent leaves it with stale ancestorIds and a delete orphans it
        // permanently, with no error anywhere and no way to find it afterwards.
        //
        // The cost is a product restriction: a private card cannot live inside
        // a shared project. It sits at the root, or under another private card.
        //
        // This one *does* need a get(), and can afford it: during a reparent
        // the new parent is not itself in the batch and its visibility does not
        // change, so the get() reads correct state. Operations that do change
        // visibility (#61) or create a parent and a child together (#7) must
        // write top-down, one document at a time; they fail loudly here if they
        // forget.
        function parentOf(data) {
          return get(/databases/$(database)/documents/homes/$(homeId)/nodes/$(data.parentId)).data;
        }

        function inheritsFrom(data, parent) {
          return data.visibility == parent.visibility
            && (data.visibility != 'private'
                || data.participantIds.hasAll(parent.participantIds));
        }

        function inherits(data) {
          return data.parentId == null || inheritsFrom(data, parentOf(data));
        }

        // A batched write may make at most **20 document access calls** in
        // total, across every document in it — so an update rule that always
        // reads the parent caps a subtree operation at twenty nodes, and a
        // project with twenty tasks is ordinary rather than exotic. It fails as
        // a bare permission error, with nothing to say that size was the cause.
        //
        // So the get() is spent only on a write that could break the invariant.
        // A reparent changes the moved node's parentId — that one still pays —
        // while its descendants change only their ancestorIds, and an ordinary
        // edit changes neither. What is skipped is a re-proof of something the
        // document already satisfied and this write does not touch.
        //
        // The one window it opens is during a top-down visibility flip (#61),
        // where a child edited between its parent's flip and its own is allowed
        // through while temporarily mismatched. The flip then reaches it and
        // corrects it; the unrecoverable failure this all exists to prevent is
        // a *silent orphan*, and that needs parentId or visibility to change.
        function privacyUnchanged(next, current) {
          return next.parentId == current.parentId
            && next.visibility == current.visibility
            && next.participantIds == current.participantIds;
        }

        function immutable(next, current) {
          return next.createdAt == current.createdAt
            && next.createdBy == current.createdBy;
        }

        // A node that is not there is an *answer*, not an error. `resource` is
        // null for a document that does not exist, and reading a field off it
        // is an evaluation error, which denies the read — so a board whose card
        // somebody else deleted came back as a raw permission error instead of
        // "that card is gone", and the screen listening to it had a failure to
        // log rather than a fact to act on. `list` keeps the strict form: a
        // query never matches a document that does not exist, so nothing about
        // query safety changes.
        allow get: if isMember(homeId)
          && (resource == null || visibleToMe(resource.data));
        allow list: if isMember(homeId) && visibleToMe(resource.data);
        allow create: if isMember(homeId)
          && visibleToMe(request.resource.data)
          && validNode(request.resource.data)
          && structure(request.resource.data)
          && inherits(request.resource.data);
        allow update: if isMember(homeId)
          && visibleToMe(resource.data)
          && visibleToMe(request.resource.data)
          && validNode(request.resource.data)
          && structure(request.resource.data)
          && immutable(request.resource.data, resource.data)
          && (privacyUnchanged(request.resource.data, resource.data)
              || inherits(request.resource.data));
        allow delete: if isMember(homeId) && visibleToMe(resource.data);
      }

      match /locations/{locationId} {
        allow read, write: if isMember(homeId);
      }

      match /recurring/{ruleId} {
        allow read, write: if isMember(homeId);
      }
    }

    // How an invitee finds an invitation at all.
    //
    // They cannot read the home document and do not know its id, so the invite
    // is unreachable by path; and documentId() in a collection-group query
    // compares the *full document path* rather than the last segment, so the
    // hash in the key is not queryable either. Hence the `emailHash` field, and
    // hence this rule — `collectionGroup('invites').where('emailHash', '==',
    // myHash)` is query-safe because every document that can match carries the
    // caller's own hash, which is exactly what is tested here.
    //
    // It widens nothing: the nested rule already grants the hash holder read
    // access to the same documents. Writes stay on the nested rule alone.
    match /{path=**}/invites/{emailHashId} {
      allow get, list: if hasEmail() && resource.data.emailHash == emailHash();
    }
  }
}
