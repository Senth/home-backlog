{
	"name": "home-backlog",
	"main": "index.ts",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"build:web": "expo export --platform web",
		"lint": "biome check",
		"invariants": "scripts/check-invariants.sh",
		"format": "biome format --write",
		"typecheck": "tsc --noEmit && yarn --cwd functions typecheck",
		"test": "jest && yarn --cwd functions test",
		"postinstall": "yarn --cwd functions install",
		"test:rules": "node scripts/test-rules.mjs",
		"e2e": "scripts/dev-stack.sh up && scripts/e2e.sh",
		"e2e:report": "playwright show-report .tmp/e2e/report",
		"emulators": "scripts/dev-stack.sh up --no-web",
		"emulators:export": "scripts/dev-stack.sh export",
		"icon-names": "node scripts/gen-icon-names.mjs",
		"icons": "python3 scripts/gen-icons.py",
		"todo": "scripts/sync-todo.sh"
	},
	"jest": {
		"preset": "jest-expo",
		"clearMocks": true,
		"testPathIgnorePatterns": [
			"<rootDir>/node_modules/",
			"<rootDir>/tests/rules/",
			"<rootDir>/e2e/",
			"<rootDir>/functions/"
		],
		"transformIgnorePatterns": [
			"node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@react-native-firebase|firebase|react-native-paper|fractional-indexing))"
		]
	},
	"dependencies": {
		"@expo/vector-icons": "15.1.1",
		"@react-native-async-storage/async-storage": "3.1.1",
		"@react-navigation/bottom-tabs": "^7.15.5",
		"@react-navigation/native": "^7.1.33",
		"expo": "~55.0.28",
		"expo-auth-session": "~55.0.17",
		"expo-clipboard": "~55.0.15",
		"expo-constants": "~55.0.17",
		"expo-linking": "~55.0.16",
		"expo-localization": "~55.0.17",
		"expo-router": "~55.0.17",
		"expo-splash-screen": "~55.0.23",
		"expo-status-bar": "55.0.6",
		"expo-web-browser": "~55.0.18",
		"firebase": "12.19.0",
		"fractional-indexing": "^4.0.0",
		"i18next": "26.4.2",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-i18next": "17.0.15",
		"react-native": "0.83.10",
		"react-native-gesture-handler": "~2.33.0",
		"react-native-paper": "5.15.3",
		"react-native-paper-dates": "^0.24.0",
		"react-native-reanimated": "4.7.0",
		"react-native-safe-area-context": "~5.10.0",
		"react-native-screens": "~4.28.0",
		"react-native-svg": "15.15.5",
		"react-native-web": "0.21.2",
		"react-native-worklets": "0.13.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.14",
		"@firebase/rules-unit-testing": "^5.0.0",
		"@playwright/test": "1.63.0",
		"@testing-library/react-native": "~13",
		"@types/jest": "29.5.14",
		"@types/node": "^26.2.0",
		"@types/react": "19.3.0",
		"@types/react-test-renderer": "^19.3.0",
		"jest": "^29",
		"jest-expo": "~55",
		"react-test-renderer": "19.3.0",
		"typescript": "~5.9.2"
	}
}
