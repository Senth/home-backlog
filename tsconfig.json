{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		// `types` is a whitelist: anything omitted here is invisible even when
		// installed. `node` is needed by the rules tests, which read the rule
		// files off disk.
		"types": ["jest", "node"],
		"paths": {
			"@/*": ["./*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
